{
  "description": "kernel-browser: primer, browser create guard, browser tracking and cleanup, key guard, result redaction",
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "sh", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/primer.sh", "session"], "timeout": 10 } ] }
    ],
    "SubagentStart": [
      { "hooks": [ { "type": "command", "command": "sh", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/primer.sh", "subagent"], "timeout": 5 } ] }
    ],
    "PreToolUse": [
      { "matcher": "^mcp__(plugin_kernel-(browser|dev)_)?kernel__(manage_browsers|manage_browser_pools)$",
        "hooks": [ { "type": "command", "command": "sh", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/create-guard.sh"], "timeout": 5 } ] },
      { "matcher": "^(Edit|Write|MultiEdit|NotebookEdit|Bash)$|^mcp__(plugin_kernel-(browser|dev)_)?kernel__",
        "hooks": [ { "type": "command", "command": "sh", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/secret-guard.sh"], "timeout": 5 } ] }
    ],
    "PostToolUse": [
      { "matcher": "^mcp__(plugin_kernel-(browser|dev)_)?kernel__(manage_browsers|manage_profiles|manage_browser_pools)$",
        "hooks": [ { "type": "command", "command": "sh", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/track.sh"], "timeout": 5 } ] },
      { "matcher": "^mcp__(plugin_kernel-(browser|dev)_)?kernel__",
        "hooks": [ { "type": "command", "command": "sh", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/redact.sh"], "timeout": 5 } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "sh", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/stop-guard.sh", "stop"], "timeout": 10 } ] }
    ],
    "SubagentStop": [
      { "hooks": [ { "type": "command", "command": "sh", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/stop-guard.sh", "subagent"], "timeout": 10 } ] }
    ],
    "SessionEnd": [
      { "hooks": [ { "type": "command", "command": "sh", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/session-end.sh"] } ] }
    ]
  }
}
